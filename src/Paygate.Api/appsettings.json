{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "CreateSchemaOnStartup": true
  },
  "ConnectionStrings": {
    "Paygate": "Data Source=paygate.db"
  },

  "ApiKeys": {
    "Clients": []
  },

  "RateLimiting": {
    "PermitsPerSecond": 20,
    "Burst": 40,
    "WebhookPermitsPerSecond": 100
  },

  "Idempotency": {
    "RetentionPeriod": "1.00:00:00",
    "InFlightLockTimeout": "00:00:30",
    "MaxRequestBodyBytes": 65536,
    "CleanupInterval": "00:10:00"
  },

  "Resilience": {
    "AttemptTimeout": "00:00:01",
    "TotalTimeout": "00:00:04",
    "MaxRetryAttempts": 2,
    "RetryBaseDelay": "00:00:00.100",
    "FailureRatio": 0.5,
    "MinimumThroughput": 3,
    "SamplingDuration": "00:00:30",
    "BreakDuration": "00:00:30"
  },

  "Providers": {
    "heron": {
      "DisplayName": "Heron Acquiring (simulated card acquirer)",
      "ReferencePrefix": "hrn",
      "Methods": [ "Card" ],
      "Currencies": [ "EUR", "GBP", "USD", "CAD", "SEK", "NOK", "DKK", "PLN" ],
      "SupportsPayouts": true,
      "SupportsRefunds": true,
      "SupportsIdempotencyKeys": true,
      "Faults": { "LatencyMs": 120 }
    },
    "osprey": {
      "DisplayName": "Osprey Local Payments (simulated bank transfers and domestic cards)",
      "ReferencePrefix": "osp",
      "Methods": [ "Card", "BankTransfer" ],
      "AsyncMethods": [ "BankTransfer" ],
      "Currencies": [ "EUR", "SEK", "NOK", "DKK", "PLN", "BRL" ],
      "Countries": [ "AT", "BR", "DE", "DK", "FI", "NL", "NO", "PL", "SE" ],
      "SupportsPayouts": true,
      "SupportsRefunds": true,
      "SupportsIdempotencyKeys": true,
      "Faults": { "LatencyMs": 90 }
    },
    "wren": {
      "DisplayName": "Wren Crypto (simulated crypto on/off-ramp)",
      "ReferencePrefix": "wrn",
      "Methods": [ "CryptoWallet" ],
      "AsyncMethods": [ "CryptoWallet" ],
      "Currencies": [ "EUR", "USD", "CAD", "BRL" ],
      "SupportsPayouts": true,
      "SupportsRefunds": false,
      "SupportsIdempotencyKeys": false,
      "Faults": { "LatencyMs": 250 }
    }
  },

  "Routing": {
    "Rules": [
      {
        "Name": "high-value-eur-cards",
        "Methods": [ "Card" ],
        "Currencies": [ "EUR" ],
        "MinAmount": 500000,
        "Targets": [
          { "Provider": "osprey", "Priority": 1 },
          { "Provider": "heron", "Priority": 2 }
        ]
      },
      {
        "Name": "nordic-cards",
        "Methods": [ "Card" ],
        "Countries": [ "SE", "NO", "DK", "FI" ],
        "Targets": [
          { "Provider": "heron", "Priority": 1, "Weight": 70 },
          { "Provider": "osprey", "Priority": 1, "Weight": 30 }
        ]
      },
      {
        "Name": "cards",
        "Methods": [ "Card" ],
        "Targets": [
          { "Provider": "heron", "Priority": 1 },
          { "Provider": "osprey", "Priority": 2 }
        ]
      },
      {
        "Name": "bank-transfers",
        "Methods": [ "BankTransfer" ],
        "Targets": [ { "Provider": "osprey", "Priority": 1 } ]
      },
      {
        "Name": "crypto",
        "Methods": [ "CryptoWallet" ],
        "Targets": [ { "Provider": "wren", "Priority": 1 } ]
      }
    ]
  }
}
